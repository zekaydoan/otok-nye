# Oturum jetonlarını (JWT) imzalamak için kullanılır. Üretimde ZORUNLUDUR — tanımlı
# değilse uygulama isteği reddeder (bkz. lib/auth.ts). En az 32 karakterlik, rastgele
# üretilmiş bir değer kullanın, ör.: `openssl rand -hex 32`
AUTH_SECRET=cok-gizli-uzun-bir-anahtar-buraya

# SMS ile otomatik bakım hatırlatma ve onay mesajları için (Netgsm). Tanımlanmazsa
# SMS gönderimi sessizce atlanır, uygulamanın geri kalanı normal çalışmaya devam eder.
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Etiket Mağazası: fiziksel QR etiket siparişlerinde ödeme için iyzico Checkout Form
# entegrasyonu (bkz. lib/iyzico.ts). Test için sandbox anahtarlarını, canlıya
# alırken gerçek (production) anahtarları ve IYZICO_BASE_URL'i kullanın.
# Sandbox anahtarları: https://sandbox-merchant.iyzipay.com adresinden alınır.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com — Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Şifre sıfırlama e-postaları için Resend API (bkz. lib/email.ts). Tanımlanmazsa
# e-posta gönderimi sessizce atlanır ve bağlantı geliştirme ortamında konsola
# yazılır — akışı e-posta sağlayıcısı bağlanmadan da test edebilirsiniz.
RESEND_API_KEY=
RESEND_FROM="Oto Künye <bildirim@sizin-domaininiz.com>"

# Etiket siparişlerini yönetebilecek (durum/kargo güncelleme) yönetici hesaplarının
# e-postaları, virgülle ayrılmış. Boşsa /admin/siparisler kimseye açılmaz.
ADMIN_EMAILS=
